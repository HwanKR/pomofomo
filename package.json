{
  "name": "fomopomo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-wsl.cjs",
    "check:env": "node scripts/ensure-wsl.cjs",
    "dev": "node scripts/ensure-wsl.cjs && next dev",
    "build": "node scripts/ensure-wsl.cjs && next build",
    "start": "node scripts/ensure-wsl.cjs && next start",
    "lint": "node scripts/ensure-wsl.cjs && eslint",
    "test": "node scripts/ensure-wsl.cjs && vitest",
    "test:run": "node scripts/ensure-wsl.cjs && vitest run",
    "test:watch": "node scripts/ensure-wsl.cjs && vitest --watch",
    "coverage": "node scripts/ensure-wsl.cjs && vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@kyungseopk1m/holidays-kr": "^2.1.1",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "baseline-browser-mapping": "^2.11.15",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "happy-dom": "20.11.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "unrs-resolver@1.11.1": true
  }
}
